{
  "version": "1.3.1",
  "report_kind": "self_reported_ai_readiness",
  "mandatory_sections": [
    "document_identity",
    "executive_summary",
    "business_snapshot",
    "methodology_limitations",
    "seven_dimension_results",
    "uncertainty_coverage",
    "positive_capabilities",
    "gaps_and_evidence",
    "critical_safety_gates",
    "primary_path",
    "three_priority_actions",
    "budget_and_capacity_fit",
    "next_30_60_90_days",
    "client_consultation_cta",
    "appendix_answers_and_provenance"
  ],
  "document_identity": {
    "fields": [
      "assessment_id",
      "created_at",
      "rubric_version",
      "engine_version",
      "report_version",
      "local_timezone",
      "source"
    ],
    "watermark": "Self-reported assessment — not independently verified"
  },
  "scoring": {
    "overall": "Show the nearest whole-number score when exact and complete; otherwise show [lower,upper], preserving uncertainty; no decimals or invented statistical confidence",
    "dimension_display": "All seven dimensions with coverage and known/unknown status",
    "unknown": "Each unknown shown explicitly as a verify action",
    "gates": "Every triggered gate shown with exact triggering evidence IDs"
  },
  "recommendations": {
    "max_priority_actions": 3,
    "each_action_fields": [
      "action_id",
      "title",
      "why_now",
      "triggering_evidence_ids",
      "prerequisites",
      "owner_role",
      "effort_class",
      "cash_cost_class",
      "cost_confidence",
      "definition_of_done",
      "suggested_time_horizon"
    ],
    "budget": "Do not imply quantified affordability without dated externally reviewed cost bounds"
  },
  "client_handoff": {
    "method": "user-controlled WhatsApp or copy summary",
    "prohibited": [
      "automatic send",
      "embedded report in querystring",
      "PII in querystring",
      "claiming delivery on click"
    ],
    "payload_fields": [
      "assessment_id",
      "primary_path",
      "readiness_score_or_interval",
      "critical_gate_codes",
      "request_to_discuss"
    ]
  },
  "consultant_review": {
    "record_fields": [
      "assessment_id",
      "receipt_method",
      "manual_verification_status",
      "reviewed_by",
      "reviewed_at",
      "confirmed_facts",
      "outstanding_questions",
      "client_budget_constraints",
      "recommended_service",
      "next_contact_action",
      "approval_state"
    ],
    "external_to_static_app": true
  }
}
