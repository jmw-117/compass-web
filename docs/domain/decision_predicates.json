{
  "version": "1.3.0",
  "status": "Proposed, needs human validation",
  "grammar": {
    "all": "all of the expressions",
    "any": "one or more expressions",
    "not": "negates expression",
    "eq": "[path,value] exact value equality",
    "lte/gte/lt": "[path,number] unknown numeric comparisons evaluate false",
    "in": "[path,allowed_array] membership",
    "unknown": "path where value is null or missing"
  },
  "evaluation_order": "core scores, active probes, gates, pilotBlockingGateCount, paths, action ranking",
  "paths": [
    "answer.*",
    "profile.*",
    "probe.*",
    "dimension.<id>.lower/upper",
    "metrics.*",
    "gate.*"
  ],
  "fallback": "P0 for unknown core evidence, otherwise identify the next foundation or pilot-feasibility question.",
  "predicates": {
    "G-URGENT-REGULATED": {
      "all": [
        {
          "in": [
            "profile.high_impact_ai_workflow",
            [
              "yes",
              "decides",
              "influences"
            ]
          ]
        },
        {
          "any": [
            {
              "in": [
                "profile.current_ai_use",
                [
                  "personal",
                  "team_pilot",
                  "operational"
                ]
              ]
            },
            {
              "eq": [
                "profile.planned_ai_use",
                "yes"
              ]
            }
          ]
        }
      ]
    },
    "G-GOV-DATA": {
      "any": [
        {
          "eq": [
            "probe.PR-GOV-SHARE",
            "Yes"
          ]
        },
        {
          "eq": [
            "probe.PR-GOV-PLANNED",
            "No"
          ]
        }
      ]
    },
    "G-DATA-UNKNOWN": {
      "all": [
        {
          "unknown": "answer.DAT-01"
        },
        {
          "unknown": "answer.DAT-02"
        }
      ]
    },
    "G-OWN-NONE": {
      "any": [
        {
          "eq": [
            "probe.PR-STR-OWNER",
            "No one yet"
          ]
        },
        {
          "all": [
            {
              "eq": [
                "answer.STR-02",
                0
              ]
            },
            {
              "not": {
                "eq": [
                  "profile.org_type",
                  "sole_proprietor"
                ]
              }
            },
            {
              "unknown": "probe.PR-STR-OWNER"
            }
          ]
        }
      ]
    },
    "G-BASELINE-MISSING": {
      "any": [
        {
          "eq": [
            "probe.PR-MET-START",
            "No"
          ]
        },
        {
          "eq": [
            "profile.baseline_known",
            "no"
          ]
        }
      ]
    },
    "P-P6": {
      "eq": [
        "gate.URGENT-REGULATED",
        true
      ]
    },
    "P-P2": {
      "eq": [
        "gate.GOV-DATA",
        true
      ]
    },
    "P-P0": {
      "any": [
        {
          "gte": [
            "metrics.unknownCount",
            3
          ]
        },
        {
          "lt": [
            "metrics.coverageUnits",
            150
          ]
        },
        {
          "all": [
            {
              "unknown": "answer.DAT-01"
            },
            {
              "unknown": "answer.DAT-02"
            }
          ]
        }
      ]
    },
    "P-P1": {
      "any": [
        {
          "lte": [
            "dimension.PRO.upper",
            1.5
          ]
        },
        {
          "lte": [
            "dimension.DAT.upper",
            1.5
          ]
        }
      ]
    },
    "P-P4": {
      "all": [
        {
          "lte": [
            "answer.TEC-01",
            2
          ]
        },
        {
          "lte": [
            "answer.TEC-02",
            2
          ]
        }
      ]
    },
    "P-P3": {
      "lte": [
        "dimension.PEO.upper",
        1.5
      ]
    },
    "P-P5": {
      "all": [
        {
          "gte": [
            "metrics.coverageUnits",
            180
          ]
        },
        {
          "gte": [
            "dimension.DAT.lower",
            2
          ]
        },
        {
          "gte": [
            "answer.GOV-01",
            2
          ]
        },
        {
          "gte": [
            "answer.GOV-02",
            2
          ]
        },
        {
          "gte": [
            "answer.STR-02",
            2
          ]
        },
        {
          "gte": [
            "answer.MET-01",
            2
          ]
        },
        {
          "gte": [
            "answer.PEO-01",
            2
          ]
        },
        {
          "gte": [
            "answer.PRO-01",
            2
          ]
        },
        {
          "gte": [
            "answer.TEC-01",
            2
          ]
        },
        {
          "in": [
            "profile.staff_capacity",
            [
              "limited",
              "available"
            ]
          ]
        },
        {
          "eq": [
            "metrics.pilotBlockingGateCount",
            0
          ]
        }
      ]
    },
    "G-DATA-POOR": {
      "any": [
        {
          "eq": [
            "answer.DAT-01",
            0
          ]
        },
        {
          "eq": [
            "probe.PR-DAT-ERROR",
            "Yes"
          ]
        }
      ]
    }
  }
}
